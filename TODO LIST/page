import React, { useState } from 'react';
import './TodoList.css';

const TodoList = () => {
  const [formData, setFormData] = useState({
    name: '',
    age: '',
    date: '',
    domain: ''
  });
  const [todos, setTodos] = useState([]);

  const handleInputChange = (e) => {
    const { id, value } = e.target;
    setFormData(prev => ({
      ...prev,
      [id]: value
    }));
  };

  const handleAddTodo = () => {
    const { name, age, date, domain } = formData;
    
    if (name && age && date && domain) {
      const newTodo = {
        id: Date.now(),
        name,
        age,
        date,
        domain
      };
      
      setTodos(prev => [...prev, newTodo]);
      setFormData({
        name: '',
        age: '',
        date: '',
        domain: ''
      });
    } else {
      alert("Please fill in all fields");
    }
  };

  const handleDeleteTodo = (id) => {
    if (confirm("Are you sure you want to delete this item?")) {
      setTodos(prev => prev.filter(todo => todo.id !== id));
    }
  };

  const formatDate = (dateString) => {
    const date = new Date(dateString);
    return date.toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'short',
      day: 'numeric'
    });
  };

  return (
    <div>
      <h1>TODO LIST</h1>
      
      <div id="container-1">
        <div id="sub-container-1">
          <input 
            id="name"
            type="text" 
            placeholder="Name"
            value={formData.name}
            onChange={handleInputChange}
          />
          <input 
            id="age"
            type="number" 
            placeholder="Age"
            value={formData.age}
            onChange={handleInputChange}
          />
          <input 
            id="date"
            type="date"
            value={formData.date}
            onChange={handleInputChange}
          />
          <input 
            id="domain"
            type="text" 
            placeholder="Domain"
            value={formData.domain}
            onChange={handleInputChange}
          />
          <button id="button-add" onClick={handleAddTodo}>
            ADD
          </button>
        </div> 
      </div>

      <div id="container-2">
        {todos.map(todo => (
          <div key={todo.id} className="todo-item">
            <h2>{todo.name}</h2>
            <h3>Age: {todo.age}</h3>
            <h3>Date: {formatDate(todo.date)}</h3>
            <h3>Domain: {todo.domain}</h3>
            <button onClick={() => handleDeleteTodo(todo.id)}>
              Delete
            </button>
          </div>
        ))}
      </div>
    </div>
  );
};

export default TodoList;



